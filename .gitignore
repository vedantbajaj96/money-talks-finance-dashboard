# User data & secrets
config.json
data/
.env
deploy.env

# Python
__pycache__/
*.pyc
*.pyo

# Node
node_modules/
moneytalks/node_modules/
npm-debug.log*

# Compiled JSX (generated at build/startup time)
moneytalks/*.js.compiled

# Test artifacts
.pytest_cache/
test-results/
htmlcov/
.coverage

# Logs
*.log
deploy.log

# OS
.DS_Store
.claude/
Design Ideas/

# Python venv
.venv/

# Misc
*.parquet
*.db
*.sqlite

# Eval outputs (contain real transaction data)
evals/*.xlsx
evals/*.csv

# Terraform secrets — never commit actual values
terraform/terraform.tfvars
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfstate.*.backup

# Vite build output — generated, not committed
frontend/dist/
